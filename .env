# ══════════════════════════════════════════════
#  SavePoint — Variables d'environnement
#  Copie ce fichier en .env et remplis les valeurs
#  Ne jamais committer le fichier .env sur GitHub !
# ══════════════════════════════════════════════

# ── Kaggle ─────────────────────────────────────
# Récupère ta clé sur https://www.kaggle.com/settings → API
KAGGLE_USERNAME=ton_username_kaggle
KAGGLE_KEY=ta_clé_api_kaggle

# ── RAWG API ────────────────────────────────────
# Clé gratuite sur https://rawg.io/apidocs
RAWG_API_KEY=fc70fa11d0e546ba976dd7fed119423d

# ── PostgreSQL ──────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=savepoint
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ton_mot_de_passe

# ── Airflow ─────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:ton_mot_de_passe@localhost:5432/airflow
